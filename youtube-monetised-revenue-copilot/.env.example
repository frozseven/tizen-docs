# --- YouTube Data API v3 ---
# Free key from https://console.cloud.google.com/apis/credentials after enabling "YouTube Data API v3".
# Used for: public channel stats, search, trending videos. No OAuth needed.
YOUTUBE_API_KEY=

# --- YouTube Analytics API (OAuth) ---
# OAuth client (Desktop app type) from the same Google Cloud project, with
# "YouTube Analytics API" enabled. Required only for `ytcopilot diagnose --use-analytics`
# and `ytcopilot schedule`, since watch-hours and audience geo/day data are private
# to the channel owner and are not exposed by the public Data API.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Populated automatically on first `ytcopilot auth` run; do not fill in by hand.
YOUTUBE_OAUTH_TOKEN_PATH=.ytcopilot_token.json

# --- Anthropic API ---
# https://console.anthropic.com/settings/keys
# Used for: script, title, description, chapters, and thumbnail design-brief generation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Gemini (image generation) ---
# https://aistudio.google.com/apikey
# Used for: rendering the actual thumbnail PNG from the generated design brief.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
