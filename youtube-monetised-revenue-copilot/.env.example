# --- YouTube Data API v3 ---
# Free key from https://console.cloud.google.com/apis/credentials after enabling "YouTube Data API v3".
# Used for: public channel stats, search, trending videos. No OAuth needed.
YOUTUBE_API_KEY=

# --- YouTube Analytics API (OAuth) ---
# OAuth client (Desktop app type) from the same Google Cloud project, with
# "YouTube Analytics API" enabled. Required only for `ytcopilot diagnose --use-analytics`
# and `ytcopilot schedule`, since watch-hours and audience geo/day data are private
# to the channel owner and are not exposed by the public Data API.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Populated automatically on first `ytcopilot auth` run; do not fill in by hand.
YOUTUBE_OAUTH_TOKEN_PATH=.ytcopilot_token.json
# Optional: only needed on a host with no persistent disk (e.g. Render's free
# tier), where YOUTUBE_OAUTH_TOKEN_PATH gets wiped on every restart. After
# connecting once via the web dashboard, copy the refresh token it shows you
# into this variable so restarts don't require reconnecting — see docs/DEPLOY.md.
YOUTUBE_OAUTH_REFRESH_TOKEN=

# --- Google Gemini ---
# https://aistudio.google.com/apikey
# Used for: script, title, description, chapters, and thumbnail design-brief generation
# (text), plus rendering the actual thumbnail PNG (image). One key covers both.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Web dashboard (webapp/) ---
# Every dashboard action spends real API credits, so if you deploy this
# anywhere reachable beyond your own machine, set BOTH of these — the app
# then requires this username/password (HTTP Basic Auth) on every request.
# Leave both blank only for strictly local use (http://localhost).
WEBAPP_USERNAME=
WEBAPP_PASSWORD=
# Must match the redirect URI registered on the OAuth client below, and the
# host/port you actually run the app on.
WEBAPP_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
